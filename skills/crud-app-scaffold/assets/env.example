# Copied to .env by `task setup`. .env is git-ignored; never commit real secrets.

# Local Postgres from docker-compose.yml (change DB_PORT if 5432 is taken)
DB_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

APP_ENV=development
PORT=8080

# Session signing key. Any 32+ char random string (openssl rand -base64 32). Required in production.
JWT_SECRET=
JWT_TTL=24h

# Open self-signup. Defaults: true in development, false in production (admins create users).
# ALLOW_SIGNUP=true

# Optional: create this admin on startup if missing (required in production for the first login).
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Optional: used by `task deploy`
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxxxxx
